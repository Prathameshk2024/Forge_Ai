# --- Required ---------------------------------------------------------------
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY = "Your_Gemini_API_Key_Here"

# --- Optional ---------------------------------------------------------------
# Port the API listens on (Render and most hosts set this for you).
# PORT = 3000

# The primary model, and the one used only when the primary is rate-limited or
# overloaded. Keep these DIFFERENT - setting both to the same name leaves you
# with no fallback and doubles the requests spent hitting the same quota wall.
# GEMINI_MODEL = gemini-3.5-flash
# GEMINI_FALLBACK_MODEL = gemini-3-flash-preview

# Comma-separated origins allowed to call this API. Unset means "any origin",
# which is fine locally but in production lets any site spend your Gemini quota.
# ALLOWED_ORIGINS = https://forgeai-web.onrender.com
